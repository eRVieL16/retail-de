# Databricks SQL Warehouse connection (used by dbt profiles.yml and test_connection.py)
# Find these under: Databricks Workspace -> SQL Warehouses -> [your warehouse] -> Connection details
DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATABRICKS_CATALOG=de_project
DATABRICKS_SCHEMA=silver

# Synthetic data generation (scripts/generate_data.py, scripts/generate_inventory.py)
NUM_STORES=30
NUM_PRODUCTS=200
NUM_DAYS_HISTORY=90